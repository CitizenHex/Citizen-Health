{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Citizen Health",
  "version": "0.1.0",
  "identifier": "com.zerodiv1de.citizenhealth",
  "build": {
    "frontendDist": ".."
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Citizen Health",
        "width": 1040,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'none'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "windows": {
      "digestAlgorithm": "sha256"
    }
  }
}
